{
  "name": "google-flow-mcp",
  "version": "2.0.0",
  "description": "MCP server for Google Flow (flow.google.com) via browser automation: batch image/video generation, upscaled downloads, hot reload",
  "keywords": [
    "Image",
    "generation",
    "Video",
    "generation",
    "browser",
    "automation"
  ],
  "homepage": "https://github.com/d-beloved/google-flow-mcp#readme",
  "bugs": {
    "url": "https://github.com/d-beloved/google-flow-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-beloved/google-flow-mcp.git"
  },
  "license": "MIT",
  "author": "Ayodeji Moronkeji (https://morayodeji.dev)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-flow-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "config/flow.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start-browser": "node scripts/run.js start-browser",
    "start-mcp": "node scripts/run.js start-mcp",
    "register": "node scripts/run.js register",
    "test": "node scripts/run.js test-flow-image"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "playwright": "^1.51.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "contributors": [
    "Shaig Mahmudov (original project)"
  ]
}
